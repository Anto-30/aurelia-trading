{
  "name": "AURELIA Mobile Cloud Workbench",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "AURELIA_DEPLOYMENT_MODE": "VERIFY_ONLY",
    "AURELIA_AUTONOMOUS_LOOP": "false",
    "AURELIA_VERIFY_DERIV_AUTH": "false",
    "AURELIA_RUN_ONCE": "true"
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt pytest",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": false,
        "python.testing.unittestEnabled": true,
        "editor.formatOnSave": false
      }
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "AURELIA local verify-only runtime",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  }
}