{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurelia.invalid/schemas/aurelia-certification-report-v1.json",
  "title": "AURELIA Certification Evidence Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_utc",
    "repository",
    "assessed_main_commit",
    "overall_status",
    "release_authorization",
    "evidence_policy",
    "gates",
    "historical_data_gate",
    "dependency_intake",
    "required_human_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "aurelia.certification-report.v1"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string"
    },
    "assessed_main_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "overall_status": {
      "enum": [
        "BLOCKED",
        "READY_FOR_HUMAN_REVIEW"
      ]
    },
    "release_authorization": {
      "type": "object",
      "required": [
        "live_execution",
        "final_execution_authorization",
        "capital_plane_mode",
        "research_capital_authority",
        "lock_file",
        "modification_permitted_by_this_report"
      ],
      "properties": {
        "live_execution": {
          "const": "BLOCKED"
        },
        "final_execution_authorization": {
          "const": false
        },
        "capital_plane_mode": {
          "const": "VERIFY_ONLY"
        },
        "research_capital_authority": {
          "const": false
        },
        "lock_file": {
          "const": "config/LIVE_LOCK.yaml"
        },
        "lock_file_sha256_git_blob": {
          "type": "string"
        },
        "modification_permitted_by_this_report": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "evidence_policy": {
      "type": "object",
      "required": [
        "missing_evidence_is_failure",
        "test_success_alone_means_live_ready",
        "external_candidates_auto_approved",
        "live_or_real_money_actions_performed",
        "report_is_authorization"
      ],
      "properties": {
        "missing_evidence_is_failure": {
          "const": true
        },
        "test_success_alone_means_live_ready": {
          "const": false
        },
        "external_candidates_auto_approved": {
          "const": false
        },
        "live_or_real_money_actions_performed": {
          "const": false
        },
        "report_is_authorization": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "evidence",
          "blocker"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "type": "array"
          },
          "blocker": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "historical_data_gate": {
      "type": "object"
    },
    "dependency_intake": {
      "type": "object"
    },
    "required_human_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
