{
  "schema": "aurelia.agent_capability_boundary.v1",
  "capital_authority": false,
  "actors": {
    "Grok": {
      "role": "orchestration/research/blocker diagnosis",
      "may": [
        "decompose",
        "research",
        "propose",
        "synchronize_skill_registry"
      ],
      "may_not": [
        "authorize_capital",
        "submit_orders",
        "flip_live_lock"
      ],
      "capital_authority": false
    },
    "ClaudeCode": {
      "role": "AURELIA CEO / executive orchestrator and principal engineering lead",
      "may": [
        "inspect",
        "modify_code",
        "run_tests",
        "review",
        "document",
        "decompose_prioritize_non_capital_work",
        "delegate_registered_agent_tasks",
        "coordinate_agent_reviews",
        "track_delivery_evidence",
        "prepare_engineering_branches_and_pull_requests"
      ],
      "may_not": [
        "authorize_capital",
        "submit_orders",
        "flip_live_lock",
        "read_or_route_production_secrets",
        "bypass_independent_review_or_CI",
        "perform_unapproved_production_deployment"
      ],
      "capital_authority": false
    },
    "KimiK3": {
      "role": "parallel planning/sub-agent decomposition",
      "may": [
        "parallel_analysis",
        "delegate_research",
        "cross-check"
      ],
      "may_not": [
        "authorize_capital",
        "submit_orders",
        "flip_live_lock"
      ],
      "capital_authority": false
    },
    "GoogleAgentSkills": {
      "role": "multi-agent security/cloud architecture",
      "may": [
        "threat_model",
        "architecture_review",
        "deployment_design"
      ],
      "may_not": [
        "authorize_capital",
        "submit_orders",
        "flip_live_lock"
      ],
      "capital_authority": false
    },
    "GLM": {
      "role": "multimodal/document inspection",
      "may": [
        "inspect_images",
        "inspect_pdfs",
        "extract_tables",
        "cross_validate_artifacts"
      ],
      "may_not": [
        "authorize_capital",
        "submit_orders",
        "flip_live_lock"
      ],
      "capital_authority": false
    },
    "PlaywrightCLI": {
      "role": "browser/system UI verification",
      "may": [
        "browser_test",
        "trace",
        "network_assertions",
        "session_tests"
      ],
      "may_not": [
        "place_trades",
        "approve_live_release",
        "read_secrets"
      ],
      "capital_authority": false
    },
    "AURELIA": {
      "role": "sole capital/execution authority",
      "may": [
        "enforce_existing_capital_controls"
      ],
      "may_not": [
        "self_bypass_live_lock",
        "treat_simulation_as_production",
        "accept_unknown_as_success"
      ],
      "capital_authority": true
    },
    "ChatGPT": {
      "role": "supervisory reasoning, research, tool selection, independent evidence review",
      "may": [
        "decompose",
        "research",
        "inspect_repository",
        "use_connected_read_tools",
        "propose_changes",
        "cross_validate_evidence"
      ],
      "may_not": [
        "authorize_capital",
        "submit_orders",
        "flip_live_lock",
        "read_or_print_production_secrets",
        "claim_unverified_runtime_install"
      ],
      "capital_authority": false
    },
    "Dev": {
      "role": "implementation and runtime diagnostics only after an authorized host is connected",
      "may": [
        "inspect_code",
        "modify_sandbox_code",
        "run_tests",
        "capture_runtime_evidence"
      ],
      "may_not": [
        "authorize_capital",
        "submit_orders",
        "flip_live_lock",
        "read_production_secrets",
        "bypass_release_gates"
      ],
      "capital_authority": false,
      "runtime_status": "NOT_CONNECTED"
    },
    "GrokBot": {
      "role": "specialist orchestration support/research/adversarial review/blocker diagnosis",
      "may": [
        "decompose",
        "research",
        "propose",
        "synchronize_skill_registry"
      ],
      "may_not": [
        "authorize_capital",
        "submit_orders",
        "flip_live_lock"
      ],
      "capital_authority": false
    },
    "JEV": {
      "role": "validation, evidence audit, workflow and regression review",
      "may": [
        "validate_tests",
        "reconcile_evidence",
        "review_release_gates",
        "identify_contradictions"
      ],
      "may_not": [
        "authorize_capital",
        "submit_orders",
        "flip_live_lock",
        "read_production_secrets"
      ],
      "capital_authority": false
    }
  },
  "non_negotiables": [
    "FINAL_EXECUTION_AUTHORIZATION must remain false until independently certified gates are green.",
    "LIVE_EXECUTION must remain BLOCKED during all federation and repair work.",
    "External skills/plugins are advisory/engineering only.",
    "No external repository may receive capital authority.",
    "No secret values may be committed or logged.",
    "Simulation evidence must never be relabeled as authenticated broker, transaction, production, or live evidence.",
    "Every repair must be smallest-change, test-backed, and lineage-verifiable.",
    "ChatGPT and Dev are non-capital roles; Dev tools remain inactive until a user-controlled host is connected and verified.",
    "Tool, skill, plugin, and repository assignments describe eligible use; they do not prove physical installation or a live authenticated connector.",
    "ClaudeCode is the primary executive coordinator for non-capital work; its CEO designation grants no capital, secret, live-lock, or release-gate authority.",
    "Delegate only to registered agents with task-scoped capability and verified active worker leases; otherwise mark NOT_CONNECTED or PENDING_UNCLAIMED.",
    "The CEO cannot self-approve material changes; independent review and evidence reconciliation remain mandatory."
  ]
}
