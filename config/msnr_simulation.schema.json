{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anto-30/aurelia-trading/blob/main/config/msnr_simulation.schema.json",
  "title": "AURELIA MSNR historical replay configuration",
  "description": "Research-only configuration. Instrument/cost fields must come from the exact R_100 contract/source; no defaults are provided for unknown tick size, payout/value or execution cost.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "symbol", "granularity_seconds", "fold_id",
    "strategy", "regime_filter", "hmm", "execution", "provenance"
  ],
  "properties": {
    "schema": { "const": "aurelia.msnr_simulation_config.v1" },
    "symbol": { "const": "R_100" },
    "granularity_seconds": { "const": 60 },
    "fold_id": { "type": "string", "minLength": 1 },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookback_bars", "tick_size", "min_sweep_ticks", "stop_buffer_ticks",
        "max_reclaim_bars", "require_volume_pop", "volume_pop_multiplier",
        "allowed_regimes", "version"
      ],
      "properties": {
        "lookback_bars": { "type": "integer", "minimum": 3 },
        "tick_size": { "type": "number", "exclusiveMinimum": 0, "description": "Must be taken from an independently verified R_100 instrument specification, never inferred from floating-point CSV decimals." },
        "min_sweep_ticks": { "type": "number", "exclusiveMinimum": 0 },
        "stop_buffer_ticks": { "type": "number", "minimum": 0 },
        "max_reclaim_bars": { "type": "integer", "minimum": 1 },
        "require_volume_pop": { "type": "boolean", "const": false, "description": "The Deriv synthetic-index candle CSV has no verified volume; volume-pop filtering must remain disabled unless a separate source is independently verified and incorporated." },
        "volume_pop_multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "allowed_regimes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["TRENDING_LOW_VOL", "TRENDING_HIGH_VOL", "RANGING_LOW_VOL", "RANGING_HIGH_VOL"] } },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "regime_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookback_bars", "trend_efficiency_min", "high_volatility_pct", "version"],
      "properties": {
        "lookback_bars": { "type": "integer", "minimum": 2 },
        "trend_efficiency_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "high_volatility_pct": { "type": "number", "exclusiveMinimum": 0 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "hmm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_bars", "refit_every_bars", "feature_window", "filter_kind",
        "min_confidence", "max_entropy", "random_state", "alpha", "beta"
      ],
      "properties": {
        "training_bars": { "type": "integer", "minimum": 100 },
        "refit_every_bars": { "type": "integer", "minimum": 1 },
        "feature_window": { "type": "integer", "minimum": 2 },
        "filter_kind": { "enum": ["gaussian", "alpha_beta"] },
        "min_confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "max_entropy": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "random_state": { "type": "integer" },
        "alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.3333333333333333 },
        "beta": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spread_price_units_round_trip", "slippage_price_units_per_side",
        "commission_cash_per_unit_round_trip", "cash_per_price_unit_per_unit",
        "position_size_units", "max_holding_bars", "same_bar_stop_target_policy"
      ],
      "properties": {
        "spread_price_units_round_trip": { "type": "number", "minimum": 0, "description": "Observed or explicitly scenario-assumed full round-trip spread in underlying price units, not pips unless instrument metadata defines that conversion." },
        "slippage_price_units_per_side": { "type": "number", "minimum": 0, "description": "Incremental slippage in underlying price units per side; must not double count spread." },
        "commission_cash_per_unit_round_trip": { "type": "number", "minimum": 0, "description": "Verified or explicitly scenario-assumed cash commission per size unit per round trip." },
        "cash_per_price_unit_per_unit": { "type": "number", "exclusiveMinimum": 0, "description": "Cash P&L conversion for one unit of price movement and one size unit for the selected product; cannot be inferred from underlying OHLC alone." },
        "position_size_units": { "type": "number", "exclusiveMinimum": 0 },
        "max_holding_bars": { "type": "integer", "minimum": 1 },
        "same_bar_stop_target_policy": { "const": "stop_first" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["VERIFIED", "EXPLORATORY_UNVERIFIED"] },
        "instrument_source_file": { "type": "string", "minLength": 1 },
        "instrument_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "cost_source_file": { "type": "string", "minLength": 1 },
        "cost_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "observed_at_utc": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "VERIFIED" } }, "required": ["status"] },
          "then": {
            "required": ["instrument_source_file", "instrument_source_sha256", "cost_source_file", "cost_source_sha256", "observed_at_utc"]
          }
        }
      ]
    }
  }
}