  "routing_policy": {
    "minimum_samples_for_promotion": 30,
    "champion_confidence_margin": 0.05,
    "max_staleness_days": 30,
    "abstain_on_missing_evidence": true,
    "high_consequence_requires_independent_challenger": true,
    "capital_relevant_requires_deterministic_validation": true
  },
  "models": [
