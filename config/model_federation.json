{
  "schema": "aurelia.model_federation.v1",
  "purpose": "Evidence-based routing of intelligence-plane tasks across approved LLMs without capital authority.",
  "constitution": {
    "intelligence_only": true,
    "capital_authority": false,
    "live_order_authority": false,
    "live_lock_mutation": false,
    "final_execution_authorization_mutation": false,
    "deterministic_validation_required": true,
    "unknown_model_availability_is_not_assumed": true
