{
  "schema": "aurelia.repo_agent_routing.v1",
  "generated_date": "2026-10-20",
  "purpose": "Deterministically route every federated external repository to the agents best suited to consume its engineering, research, security, multimodal, browser, deployment, or orchestration capabilities. Includes security-first routing for LLM gateway and Freebuff-related reference sources.",
  "admission_policy": {
    "assignment_required": true,
    "minimum_assigned_agents": 1,
    "primary_agent_required": true,
    "capability_mapping_required": "when_repository_is_registered_as_a_skill_or_agent_source",
    "unassigned_repository_action": "REJECT_AND_REQUEST_CLASSIFICATION",
    "unknown_agent_action": "REJECT",
    "capital_authority": false,
    "production_deployment_authority": false,
    "live_order_authority": false,
    "secret_reading": false
  },
  "agents": {
    "ClaudeCode": {
      "role": "principal_implementation_and_code_review",
      "capabilities": [
        "software-engineering",
        "refactoring",
        "testing",
        "security-review",
        "integration",
        "deployment-engineering",
        "general-toolchain"
      ]
    },
    "KimiK3": {
      "role": "quantitative_research_and_validation",
      "capabilities": [
        "quant-research",
        "statistics",
        "backtesting",
        "calibration",
        "market-modeling",
        "algorithmic-trading-research",
        "data-analysis"
      ]
    },
    "GrokBot": {
      "role": "orchestration_adversarial_review_and_external_intelligence",
      "capabilities": [
        "agent-orchestration",
        "adversarial-review",
        "systems-reasoning",
        "macro-research",
        "workflow-composition",
        "external-research",
        "cross-agent-coordination"
      ]
    },
    "PlaywrightCLI": {
      "role": "browser_and_ui_verification",
      "capabilities": [
        "browser-e2e",
        "ui-verification",
        "network-testing",
        "responsive-testing",
        "desktop-ui-verification"
      ]
    },
    "GLM": {
      "role": "multimodal_document_and_visual_analysis",
      "capabilities": [
        "ocr",
        "document-analysis",
        "multimodal-inspection",
        "visual-analysis"
      ]
    },
    "GoogleAgentSkills": {
      "role": "agent-security_cloud_and_multi-agent_architecture",
      "capabilities": [
        "agent-security",
        "agent-gateway",
        "cloud-architecture",
        "multi-agent-security",
        "agentic-analytics"
      ]
    },
    "JEV": {
      "role": "decision_verification_tool_call_gating_and_agent_workflow_optimization",
      "capabilities": [
        "typed-decision-routing",
        "classification",
        "confidence-scoring",
        "draft-verification",
        "tool-call-gating",
        "agent-workflow-optimization"
      ]
    },
    "AURELIA": {
      "role": "canonical_aurelia_supervisor_and_policy_owner",
      "capabilities": [
        "system-supervision",
        "policy-evaluation",
        "cross-agent-coordination",
        "capital-plane-policy-enforcement"
      ]
    },
    "ChatGPT": {
      "role": "supervisory_reasoning_tool_selection_and_evidence_review",
      "capabilities": [
        "task-decomposition",
        "research-synthesis",
        "cross-agent-review",
        "tool-selection",
        "source-provenance",
        "risk-boundary-review"
      ],
      "runtime_status": "CURRENT_CHAT_SESSION_ONLY"
    },
    "Dev": {
      "role": "implementation_and_runtime_operations_when_connected",
      "capabilities": [
        "git",
        "local-shell",
        "python-tests",
        "docker",
        "log-inspection",
        "browser-e2e"
      ],
      "runtime_status": "NOT_CONNECTED",
      "activation_gate": "Authorized host must be connected and runtime identity verified before tool execution."
    },
    "DeepSeekHarness": {
      "role": "independent_quantitative_and_code_validation",
      "capabilities": [
        "quant-research",
        "backtest-audit",
        "walk-forward-validation",
        "lookahead-and-leakage-detection",
        "data-quality-review",
        "net-expectancy-and-cost-review",
        "test-design",
        "code-review",
        "reproducibility-audit"
      ],
      "authority": "research_and_sandbox_only",
      "runtime_status": "NOT_CONNECTED",
      "activation_state": "REGISTERED_SHADOW_ONLY",
      "capital_authority": false,
      "live_order_authority": false,
      "secret_reading": false,
      "production_deployment_authority": false,
      "note": "Governed role definition only. No model runtime or DSH plugin is installed or connected."
    }
  },
  "routing_rules": [
    {
      "priority": 97,
      "when": {
        "category_contains_any": [
          "deepseek-harness-ecosystem-catalogue"
        ]
      },
      "primary_agent": "DeepSeekHarness",
      "supporting_agents": [
        "KimiK3",
        "ClaudeCode",
        "GrokBot",
        "JEV"
      ],
      "mode_default": "REFERENCE_ONLY",
      "rationale": "DeepSeekHarness owns the independent quantitative/code-validation review of the DSH ecosystem catalogue; its source remains reference-only and has no runtime or capital authority."
    },
    {
      "priority": 100,
      "when": {
        "category_contains_any": [
          "algorithmic-trading",
          "trading-research",
          "quant-",
          "systematic-trading",
          "machine-learning-for-trading",
          "AI-trading",
          "multi-agent-trading",
          "options-strategy",
          "grid-trading",
          "crypto-trading",
          "equity-research",
          "market-data"
        ]
      },
      "primary_agent": "KimiK3",
      "supporting_agents": [
        "GrokBot",
        "ClaudeCode"
      ],
      "mode_default": "RESEARCH_ONLY",
      "rationale": "Quantitative and trading repositories require research, statistical validation, implementation review, and adversarial challenge."
    },
    {
      "priority": 95,
      "when": {
        "category_contains_any": [
          "agent-security",
          "security",
          "gateway",
          "MCP-security",
          "llm-gateway"
        ]
      },
      "primary_agent": "GoogleAgentSkills",
      "supporting_agents": [
        "ClaudeCode",
        "GrokBot"
      ],
      "mode_default": "SANDBOX_ONLY",
      "rationale": "Security-sensitive agent infrastructure is reviewed by a security-focused specialist before engineering integration."
    },
    {
      "priority": 94,
      "when": {
        "category_contains_any": [
          "browser-toolchain",
          "chrome-devtools",
          "browser-automation"
        ]
      },
      "primary_agent": "PlaywrightCLI",
      "supporting_agents": [
        "ClaudeCode",
        "GrokBot",
        "JEV"
      ],
      "mode_default": "TOOLCHAIN_ONLY",
      "rationale": "Browser diagnostics and UI automation are owned by PlaywrightCLI with implementation, orchestration and evidence-validation support. Use isolated browser profiles and do not expose authenticated broker sessions."
    },
    {
      "priority": 92,
      "when": {
        "category_contains_any": [
          "obsidian"
        ]
      },
      "primary_agent": "ClaudeCode",
      "supporting_agents": [
        "GrokBot",
        "PlaywrightCLI",
        "GLM",
        "JEV"
      ],
      "mode_default": "SANDBOX_ONLY",
      "rationale": "Obsidian vault and plugin integration is led by engineering, with orchestration, browser verification, multimodal review, and decision verification support. Vault access and third-party plugins remain sandboxed and cannot access production secrets or capital authority."
    },
    {
      "priority": 90,
      "when": {
        "category_contains_any": [
          "browser",
          "web-testing",
          "ui",
          "editor-platform",
          "desktop",
          "visual"
        ]
      },
      "primary_agent": "PlaywrightCLI",
      "supporting_agents": [
        "ClaudeCode"
      ],
      "mode_default": "TOOLCHAIN_ONLY",
      "rationale": "Browser, UI, desktop, and visual verification belongs with the browser/E2E specialist and implementation owner."
    },
    {
      "priority": 85,
      "when": {
        "category_contains_any": [
          "OCR",
          "document",
          "multimodal",
          "vision",
          "visual-analysis"
        ]
      },
      "primary_agent": "GLM",
      "supporting_agents": [
        "ClaudeCode"
      ],
      "mode_default": "REFERENCE_ONLY",
      "rationale": "Document and multimodal sources are routed to the visual/document specialist."
    },
    {
      "priority": 80,
      "when": {
        "category_contains_any": [
          "agent-team",
          "orchestration",
          "workflow",
          "kanban",
          "coordination",
          "hermes",
          "agentplane",
          "plugin",
          "agent-control-plane",
          "agent-orchestration"
        ]
      },
      "primary_agent": "GrokBot",
      "supporting_agents": [
        "ClaudeCode",
        "KimiK3"
      ],
      "mode_default": "SANDBOX_ONLY",
      "rationale": "Agent orchestration and workflow sources are primarily intelligence/orchestration inputs, not capital-plane authorities."
    },
    {
      "priority": 70,
      "when": {
        "category_contains_any": [
          "railway",
          "deployment",
          "iac",
          "cloud",
          "devops"
        ]
      },
      "primary_agent": "ClaudeCode",
      "supporting_agents": [
        "GrokBot",
        "PlaywrightCLI"
      ],
      "mode_default": "TOOLCHAIN_ONLY",
      "rationale": "Deployment tooling is implemented by ClaudeCode and independently reviewed for orchestration and endpoint behavior."
    },
    {
      "priority": 60,
      "when": {
        "category_contains_any": [
          "python",
          "rust",
          "coding-agent",
          "framework",
          "library",
          "toolchain",
          "git-ci",
          "notifications"
        ]
      },
      "primary_agent": "ClaudeCode",
      "supporting_agents": [
        "KimiK3"
      ],
      "mode_default": "TOOLCHAIN_ONLY",
      "rationale": "General software tooling is consumed primarily by the implementation agent."
    },
    {
      "priority": 10,
      "when": {
        "domain": "reference"
      },
      "primary_agent": "ClaudeCode",
      "supporting_agents": [
        "GrokBot"
      ],
      "mode_default": "REFERENCE_ONLY",
      "rationale": "Unclassified reference material is kept available to engineering and external-intelligence review without execution authority."
    }
  ],
  "assignment_contract": {
    "repository_entry_must_contain": [
      "repo",
      "category",
      "domain",
      "assigned_agents",
      "mode",
      "source_url",
      "head_commit"
    ],
    "assignment_semantics": {
      "assigned_agents_order": "first=primary, remaining=supporting",
      "primary_agent_must_match": "highest-priority applicable routing rule unless an explicit reviewed exception is recorded",
      "exception_requires": [
        "reason",
        "reviewed_by",
        "review_date"
      ],
      "available_sources_note": "Assigned agents are logical routing permissions. They do not prove a repository clone, skill activation, plugin connection, or physical runtime installation."
    },
    "capability_mapping_semantics": "agent_skill_federation entry is required only when the repository is consumed as a skill/plugin/agent source; repository-agent assignment is mandatory for every federated repository."
  }
}
