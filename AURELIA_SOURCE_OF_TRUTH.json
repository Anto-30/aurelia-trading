{
  "schema": "aurelia.source_of_truth.v1",
  "repository": "Anto-30/aurelia-trading",
  "canonical_branch": "main",
  "default_branch": "main",
  "source_resolution": "read_current_HEAD_of_main",
  "live_release_control": "config/LIVE_LOCK.yaml",
  "runtime_entrypoint": "runtime/main.py",
  "readiness_orchestrator": "runtime/ops/readiness_orchestrator.py",
  "capital_plane": "capital/capital_plane.py",
  "capital_execution_authority": "runtime/broker/executor.py",
  "deriv_adapter": "runtime/adapters/deriv_adapter.py",
  "deriv_session_manager": "runtime/adapters/session_manager.py",
  "deriv_rest_base": "https://api.derivws.com/trading/v1/options",
  "deriv_options_ws_host": "api.derivws.com",
  "deriv_options_ws_path": "/trading/v1/options/ws/{real|demo}",
  "legacy_deriv_ws": "wss://ws.derivws.com/...",
  "legacy_deriv_status": "diagnostic_only",
  "research_capital_authority": false,
  "external_repositories_capital_forbidden": true,
  "live_lock_active": true,
  "live_execution_current": "BLOCKED",
  "final_execution_authorization_current": false,
  "starting_stake_usd": 1,
  "execution_minimum_stake_usd": 1,
  "stake_sizing_mode": "balance_scaled_max_loss",
  "stake_max_trade_risk_fraction": 0.01,
  "minimum_available_balance_for_starting_stake_usd": 100,
  "stake_ceiling": "authoritative_verified_available_balance",
  "probability_min": 0.5,
  "probability_max": 0.75,
  "probability_clipping": false,
  "secret_policy": "secret_values_must_not_be_committed_or_logged",
  "github_remote_read_verified": true,
  "github_remote_write_verified": true,
  "github_canonical_branch": "main",
  "note": "Current source is resolved directly from the remote main branch; commit identity must be read from the branch tip at time of use. LIVE stake sizing is denominated in USD and blocks non-USD accounts until a verified conversion policy exists.",
  "deployment_primary_provider": "self_hosted",
  "deployment_policy": "config/deployment_policy.json",
  "deployment_workflow": ".github/workflows/self-hosted-runtime-deploy.yml",
  "deployment_script": "scripts/deploy/bootstrap_and_deploy.sh",
  "deployment_runtime": "linux_docker",
  "trial_dependency": false,
  "provider_lock": false,
  "stake_currency": "USD"
}
